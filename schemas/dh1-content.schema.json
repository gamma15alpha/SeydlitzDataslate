{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seydlitz-dataslate/schemas/dh1-content.schema.json",
  "title": "Dark Heresy 1e content",
  "description": "Содержимое пакета контента DH1. Записи каталогов — catalogEntry: id + localizedText.",
  "type": "object",
  "properties": {
    "characteristics": {
      "type": "array",
      "items": {
        "$ref": "content.schema.json#/$defs/catalogEntry",
        "properties": {
          "id": {
            "enum": [
              "ws",
              "bs",
              "s",
              "t",
              "ag",
              "int",
              "per",
              "wp",
              "fel"
            ]
          }
        }
      }
    },
    "rules": {
      "description": "Механики и справочный материал; текст — description.",
      "type": "array",
      "items": {
        "$ref": "content.schema.json#/$defs/catalogEntry"
      }
    },
    "items": {
      "description": "Предметы; характеристики предметов — позже, пока текст в description.",
      "type": "array",
      "items": {
        "$ref": "content.schema.json#/$defs/catalogEntry"
      }
    },
    "homeworlds": {
      "type": "array",
      "items": {
        "$ref": "content.schema.json#/$defs/catalogEntry"
      }
    },
    "careers": {
      "type": "array",
      "items": {
        "$ref": "content.schema.json#/$defs/catalogEntry",
        "properties": {
          "ranks": {
            "description": "Ранги карьеры по порядку.",
            "type": "array",
            "items": {
              "$ref": "content.schema.json#/$defs/catalogEntry"
            }
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "content.schema.json#/$defs/catalogEntry",
        "required": [
          "characteristic",
          "kind"
        ],
        "properties": {
          "characteristic": {
            "enum": [
              "ws",
              "bs",
              "s",
              "t",
              "ag",
              "int",
              "per",
              "wp",
              "fel"
            ]
          },
          "kind": {
            "enum": [
              "basic",
              "advanced"
            ],
            "description": "basic — можно без обучения (половина характеристики); advanced — только с обучением."
          },
          "specializations": {
            "type": "boolean",
            "default": false,
            "description": "Навык берётся по специализациям."
          },
          "specializationOptions": {
            "description": "Известные специализации; игрок может ввести и свою.",
            "type": "array",
            "items": {
              "$ref": "content.schema.json#/$defs/catalogEntry"
            }
          }
        }
      }
    }
  }
}
